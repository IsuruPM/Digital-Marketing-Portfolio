{
  "$name": "Soft Ground",
  "$version": "1.0.0",
  "$description": "Design tokens extracted from the digital-marketing reference layout. Single light theme by design.",
  "color": {
    "surface": {
      "ground": {
        "value": "#F1F0EE",
        "usage": "Page background. Warm grey — never pure white."
      },
      "surface": {
        "value": "#FFFFFF",
        "usage": "Cards, nav bar, stat cells."
      },
      "sunk": {
        "value": "#EAE8E5",
        "usage": "Image placeholders, disabled fields, ghost-control hover."
      },
      "hairline": {
        "value": "#E4E2DF",
        "usage": "1px separators and card borders. Replaces shadow."
      }
    },
    "ink": {
      "ink": {
        "value": "#17191B",
        "usage": "Headings and primary text.",
        "contrastOnGround": "14.9:1"
      },
      "ink-2": {
        "value": "#5F6367",
        "usage": "Paragraphs and card descriptions.",
        "contrastOnGround": "5.9:1"
      },
      "ink-3": {
        "value": "#8E9296",
        "usage": "Eyebrows, metric labels, captions. Uppercase or large only.",
        "contrastOnGround": "3.1:1"
      },
      "action": {
        "value": "#101214",
        "usage": "Filled pill buttons. The only colour a click receives."
      }
    },
    "tint": {
      "mint": {
        "value": "#E3EDE4",
        "category": "Search & organic",
        "usage": "Card fill only."
      },
      "sage": {
        "value": "#E9EDE8",
        "category": "Build & web",
        "usage": "Card fill only."
      },
      "blush": {
        "value": "#F8E7E2",
        "category": "Paid media",
        "usage": "Card fill only."
      },
      "cream": {
        "value": "#F7F0DF",
        "category": "Reputation & content",
        "usage": "Card fill only."
      },
      "mist": {
        "value": "#E4EBF3",
        "category": "Conversion band",
        "usage": "Reserved for the full-width CTA band."
      }
    }
  },
  "font": {
    "display": {
      "value": "\"Hanken Grotesk\", \"Helvetica Neue\", Arial, sans-serif",
      "weights": [
        300,
        400
      ]
    },
    "body": {
      "value": "\"Instrument Sans\", \"Helvetica Neue\", Arial, sans-serif",
      "weights": [
        400,
        500,
        600
      ]
    },
    "mono": {
      "value": "\"JetBrains Mono\", ui-monospace, monospace",
      "weights": [
        400,
        500
      ]
    }
  },
  "type": {
    "display-1": {
      "family": "display",
      "size": 68,
      "lineHeight": 1.04,
      "weight": 300,
      "letterSpacing": "-0.028em"
    },
    "display-2": {
      "family": "display",
      "size": 44,
      "lineHeight": 1.1,
      "weight": 300,
      "letterSpacing": "-0.024em"
    },
    "heading-1": {
      "family": "display",
      "size": 32,
      "lineHeight": 1.15,
      "weight": 300,
      "letterSpacing": "-0.020em"
    },
    "heading-2": {
      "family": "display",
      "size": 22,
      "lineHeight": 1.25,
      "weight": 400,
      "letterSpacing": "-0.014em"
    },
    "heading-3": {
      "family": "body",
      "size": 17,
      "lineHeight": 1.35,
      "weight": 500,
      "letterSpacing": "-0.008em"
    },
    "body": {
      "family": "body",
      "size": 15,
      "lineHeight": 1.65,
      "weight": 400,
      "letterSpacing": "0"
    },
    "body-sm": {
      "family": "body",
      "size": 13,
      "lineHeight": 1.6,
      "weight": 400,
      "letterSpacing": "0"
    },
    "eyebrow": {
      "family": "body",
      "size": 11,
      "lineHeight": 1.4,
      "weight": 500,
      "letterSpacing": "0.12em",
      "textTransform": "uppercase"
    },
    "metric": {
      "family": "display",
      "size": 44,
      "lineHeight": 1.0,
      "weight": 300,
      "letterSpacing": "-0.03em",
      "fontVariantNumeric": "tabular-nums",
      "superscript": {
        "size": "0.3em",
        "top": "-1.1em"
      }
    }
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 32,
    "7": 48,
    "8": 64,
    "9": 96,
    "10": 128
  },
  "layout": {
    "container": 1180,
    "gutter": 24,
    "gutterMobile": 20,
    "columns": 12,
    "gridGap": 24,
    "sectionY": 128,
    "sectionYMobile": 64,
    "cardGap": 16,
    "cardPadding": 24,
    "tintCardPadding": 20,
    "breakpoints": {
      "sm": 480,
      "md": 640,
      "lg": 768,
      "xl": 1024,
      "2xl": 1180
    },
    "grids": {
      "work": "2 col → 1 col @640",
      "services": "3 col → 2 @1024 → 1 @640",
      "metrics": "4 col → 2 @640"
    }
  },
  "radius": {
    "sm": 4,
    "md": 8,
    "lg": 12,
    "pill": 999
  },
  "border": {
    "default": "1px solid #E4E2DF"
  },
  "shadow": {
    "lift": {
      "value": "0 8px 24px rgba(20,22,24,.06)",
      "usage": "Hover on clickable cards only. The system's only shadow."
    }
  },
  "control": {
    "button": {
      "height": 40,
      "heightSm": 34,
      "padding": "11px 22px",
      "paddingSm": "8px 16px",
      "radius": 999,
      "font": "500 13px/1 body",
      "hover": "translateY(-1px), no colour change"
    },
    "tag": {
      "padding": "5px 13px",
      "radius": 999,
      "font": "400 11.5px body",
      "border": "1px solid #E4E2DF"
    },
    "arrow": {
      "size": 34,
      "radius": 999,
      "border": "1px solid #E4E2DF",
      "hover": "background #EAE8E5"
    }
  },
  "motion": {
    "ease": "cubic-bezier(.2,.7,.3,1)",
    "hover": "180ms",
    "reveal": "420ms"
  },
  "rules": {
    "do": [
      "White cards on the warm ground — that contrast is the visual idea.",
      "Display type at weight 300 with -0.028em tracking: light and tight, always together.",
      "An uppercase eyebrow on every section — it is structure, not decoration.",
      "Keep tints at fill-only saturation (L 92-95%). If it reads as colour, it is too strong.",
      "Full-bleed photography at 12px radius; product colour supplies all vibrancy."
    ],
    "dont": [
      "Add a brand accent colour — the near-black button is the accent.",
      "Bold a heading; weight 600+ appears only at 13px and below.",
      "Stack drop shadows on cards — hairlines carry separation.",
      "Mix radii inside one row, or round a button to anything but a pill.",
      "Tighten section padding to fit more in."
    ]
  }
}
