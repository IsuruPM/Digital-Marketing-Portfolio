# Apache settings for shared hosting.

# Serve index.html at the root and keep clean URLs.
DirectoryIndex index.html

# Force HTTPS once an SSL certificate is installed (uncomment the three lines below).
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Correct MIME types for fonts and SVG.
AddType font/woff2 .woff2
AddType image/svg+xml .svg

# Compression.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml font/woff2
</IfModule>

# Browser caching.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
</IfModule>

# Security headers.
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Keep the source folders private if they are ever uploaded.
RedirectMatch 404 ^/(print|scripts)(/|$)
